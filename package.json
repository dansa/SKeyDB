{
  "name": "skeydb",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build-assets.mjs && node scripts/verify-cloudflare-pages-static-fallback.mjs",
    "build:quiet": "tsc -b && vite build --logLevel error && node scripts/verify-build-assets.mjs && node scripts/verify-cloudflare-pages-static-fallback.mjs",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs}\" \"functions/**/*.{js,mjs,cjs}\" \"src/data/**/*.json\" \"src/domain/*.json\" \"package.json\" \".oxfmtrc.json\" \".oxlintrc.json\" \"doctor.config.ts\" \"vite.config.ts\" \"vitest.config.ts\" \"tsconfig*.json\" \".github/workflows/*.yml\"",
    "format:changed": "node scripts/format-changed-files.mjs",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs}\" \"functions/**/*.{js,mjs,cjs}\" \"src/data/**/*.json\" \"src/domain/*.json\" \"package.json\" \".oxfmtrc.json\" \".oxlintrc.json\" \"doctor.config.ts\" \"vite.config.ts\" \"vitest.config.ts\" \"tsconfig*.json\" \".github/workflows/*.yml\"",
    "assets:webp": "node scripts/convert-png-assets-to-webp.mjs",
    "assets:webp:dry": "node scripts/convert-png-assets-to-webp.mjs --dry-run",
    "assets:wheels:minis": "node scripts/generate-wheel-mini-assets.mjs",
    "assets:wheels:minis:check": "node scripts/generate-wheel-mini-assets.mjs --check",
    "lint": "oxlint --type-aware --report-unused-disable-directives src scripts functions doctor.config.ts vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --fix src scripts doctor.config.ts vite.config.ts vitest.config.ts",
    "doctor:check": "react-doctor --scope changed --no-telemetry --blocking error",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bounded": "vitest run --run --pool=forks --maxWorkers=4",
    "test:scripts": "node --test scripts/*.test.mjs",
    "verify:cloudflare-pages-static-fallback": "node scripts/verify-cloudflare-pages-static-fallback.mjs",
    "test:unit": "vitest run --run --exclude src/features/builder/BuilderPage*.test.tsx",
    "test:integration:builder": "vitest run --run src/features/builder/BuilderPage.awakener-basics.test.tsx src/features/builder/BuilderPage.team-management.test.tsx src/features/builder/BuilderPage.quick-lineup.test.tsx src/features/builder/BuilderPage.import-export.test.tsx src/features/builder/BuilderPage.selection.test.tsx src/features/builder/BuilderPage.covenants.test.tsx src/features/builder/BuilderPage.wheels.test.tsx",
    "test:integration:builder-v2": "vitest run --run src/features/builder-v2/BuilderV2Page.test.tsx src/features/builder-v2/useBuilderV2Model.test.ts src/features/builder-v2/builder-v2-dnd.test.ts",
    "test:integration": "npm run test:integration:builder && npm run test:integration:builder-v2",
    "test:quick": "vitest run --run src/features/collection/CollectionPage.test.tsx src/features/collection/OwnedWheelBoxExport.test.tsx src/components/ui/DupeLevelDisplay.test.tsx",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run doctor:check && npm run test:bounded && npm run test:scripts && npm run assets:wheels:minis:check && npm run build",
    "verify:builder-v2:browser": "node scripts/verify-builder-v2-browser.mjs",
    "verify:pre-commit": "node scripts/pre-commit-verify.mjs",
    "verify:pre-commit:full": "node scripts/pre-commit-verify.mjs --full",
    "prepare": "node scripts/install-git-hooks.mjs",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.4",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run verify:pre-commit"
  }
}
